# ---------------------------------------------------------------------------
# Runtime configuration. Copy to .env for local development.
# NEVER commit .env. Prod uses Managed Identity + Key Vault, not keys.
# ---------------------------------------------------------------------------

ENVIRONMENT=local
LOG_LEVEL=INFO

# --- Azure OpenAI / Foundry ------------------------------------------------
AZURE_OPENAI_ENDPOINT=https://<your-foundry-project>.openai.azure.com/
QUERY_MODEL_DEPLOYMENT=gpt-4o-mini
PRECEDENT_MODEL_DEPLOYMENT=gpt-4o
SYNTHESIS_MODEL_DEPLOYMENT=gpt-4o
# Local dev only. Leave empty to use DefaultAzureCredential. Rejected in prod.
AZURE_OPENAI_API_KEY=

# --- Azure AI Search (index populated by the ingestion pipeline) -----------
AZURE_SEARCH_ENDPOINT=https://<your-search>.search.windows.net
AZURE_SEARCH_INDEX=amsted-tax-evidence
AZURE_SEARCH_API_KEY=

# --- Platform --------------------------------------------------------------
KEY_VAULT_URI=
APPLICATIONINSIGHTS_CONNECTION_STRING=

# --- External research -----------------------------------------------------
# Keep as 'mock' until a real provider is contractually confirmed.
EXTERNAL_TAX_PROVIDER=mock
