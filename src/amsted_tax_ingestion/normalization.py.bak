"""Normalization: convert every source into one consistent internal representation.

Produces a NormalizedDocument carrying the full Seed Corpus v0.1 metadata model,
with email threads segmented into ordered messages.

Deterministic metadata (source_file, source_type, author, dates, page numbers,
thread subject) is populated here from the source itself. Semantic metadata
(scenario_id, tax_topic, jurisdiction, legal_entity, business_unit,
tax_year_or_effective_period, authority_level) is populated by the enricher.
Governance fields stay n/a until Amsted supplies classifications.
"""
from __future__ import annotations

import hashlib
import re
from datetime import datetime, timezone
from pathlib import Path

from .cleaning import clean_document_text
from .email_thread import build_thread, normalize_subject, render_thread, split_thread
from .models import NA, DocumentMetadata, ExtractedDocument, NormalizedDocument
from .utils import stable_id

_TYPE_LABELS = {
    ".pdf": "pdf", ".docx": "docx", ".pptx": "pptx", ".xlsx": "xlsx",
    ".msg": "email", ".eml": "email",
    ".html": "html", ".htm": "html", ".md": "markdown",
    ".txt": "text", ".log": "text", ".json": "json",
    ".csv": "csv", ".tsv": "csv",
}

_SOURCE_TYPE_BY_EXT = {
    ".msg": "Email Thread", ".eml": "Email Thread",
    ".pdf": "Tax Memo", ".docx": "Tax Memo",
    ".xlsx": "Spreadsheet", ".csv": "Spreadsheet", ".tsv": "Spreadsheet",
    ".pptx": "Presentation",
}

# Heuristics for detecting an email thread inside a PDF/DOCX export.
_THREAD_SIGNAL = re.compile(
    r"(?im)^\s*(?:from\s*:\s*.+|-{2,}\s*original\s+message\s*-{2,}|"
    r"-{2,}\s*forwarded\s+message\s*-{2,}|on\s+.{4,80}\s+wrote\s*:)\s*$"
)
_SUBJECT_LINE = re.compile(r"(?im)^\s*subject\s*:\s*(.+?)\s*$")

_TAX_YEAR = re.compile(
    r"\b(?:tax\s+year|fiscal\s+year|taxable\s+year|TY|FY)\s*[:\-]?\s*(\d{4})\b"
    r"|\bfor\s+the\s+(?:tax|fiscal)\s+year\s+(?:ended\s+)?\w*\s*(\d{4})\b",
    re.IGNORECASE,
)


def detect_document_type(file_name: str | Path) -> str:
    return _TYPE_LABELS.get(Path(file_name).suffix.lower(), "unknown")


def content_hash(text: str) -> str:
    return hashlib.sha256(text.encode("utf-8")).hexdigest()


def looks_like_email_thread(text: str, *, min_signals: int = 1) -> bool:
    return len(_THREAD_SIGNAL.findall(text or "")) >= min_signals


def guess_tax_year(text: str) -> str:
    """Deterministic tax-year hint. The enricher may override with better judgment."""
    match = _TAX_YEAR.search(text or "")
    if match:
        return match.group(1) or match.group(2) or NA
    return NA


def _source_type(path: Path, extracted: ExtractedDocument, is_thread: bool) -> str:
    if is_thread:
        return "Email Thread"
    return _SOURCE_TYPE_BY_EXT.get(path.suffix.lower(), "Other")


def normalize(
    path: Path,
    source_path: str,
    extracted: ExtractedDocument,
    upload_timestamp: str = "",
    *,
    scenario_ids: list[str] | None = None,
) -> NormalizedDocument:
    """Build the canonical internal representation for one source file."""
    document_type = detect_document_type(path)
    # document_id depends on source_path only, so it is stable across re-downloads.
    document_id = stable_id(source_path, prefix="doc_")

    is_thread = extracted.is_email_thread
    messages = list(extracted.messages)
    thread_subject = extracted.thread_subject

    # An email thread exported to PDF/DOCX still needs message segmentation.
    if not is_thread and document_type in {"pdf", "docx", "text", "html", "markdown"}:
        if looks_like_email_thread(extracted.text):
            subject_match = _SUBJECT_LINE.search(extracted.text)
            raw_subject = subject_match.group(1).strip() if subject_match else NA
            # Normalize so every message in the thread shares one subject value.
            thread_subject = normalize_subject(raw_subject)
            messages = split_thread(extracted.text, default_subject=thread_subject)
            is_thread = len(messages) > 0

    if is_thread and messages:
        content = render_thread(messages)
        if thread_subject == NA:
            for message in messages:
                if message.subject != NA:
                    thread_subject = message.subject
                    break
        thread_subject = normalize_subject(thread_subject)
    else:
        content = clean_document_text(extracted.text, document_type=document_type)
        messages = []

    if not content.strip():
        raise ValueError(f"Normalization produced empty content for {path.name}")

    source_type = _source_type(path, extracted, is_thread)

    # Deterministic document-level metadata. Semantic fields stay n/a for the enricher.
    first_message = messages[0] if messages else None
    last_message = messages[-1] if messages else None

    source_date = NA
    author = NA
    message_date = NA
    if first_message:
        # source_date = earliest known message; message_date = latest known message.
        known_dates = [m.message_date for m in messages if m.message_date != NA]
        source_date = known_dates[0] if known_dates else NA
        message_date = known_dates[-1] if known_dates else NA
        known_authors = [m.sender for m in messages if m.sender != NA]
        author = known_authors[0] if known_authors else NA
    elif upload_timestamp:
        source_date = upload_timestamp

    primary_scenario = (scenario_ids or [NA])[0]

    metadata = DocumentMetadata(
        scenario_id=primary_scenario,
        scenario_ids=list(scenario_ids or []),
        source_id=stable_id(document_id, prefix="src_"),
        source_file=path.name,
        source_type=source_type,
        source_date=source_date,
        author=author,
        page_number=first_message.page_number if first_message else None,
        tax_year_or_effective_period=guess_tax_year(content),
        thread_subject=thread_subject if is_thread else NA,
        message_date=message_date,
        # tax_topic, jurisdiction, legal_entity, business_unit, authority_level
        # are left n/a and filled by the enricher.
        # validity_status, current_or_superseded, access_classification remain n/a
        # until Amsted provides the classification scheme.
    )

    return NormalizedDocument(
        document_id=document_id,
        source_file_name=path.name,
        source_path=source_path,
        document_type=document_type,
        extractor=extracted.extractor or extracted.metadata.get("extractor", ""),
        upload_timestamp=upload_timestamp,
        normalization_timestamp=datetime.now(timezone.utc).isoformat(),
        content_hash=content_hash(content),
        char_count=len(content),
        page_count=extracted.page_count,
        content=content,
        metadata=metadata,
        extraction_metadata={
            **extracted.metadata,
            "raw_char_count": len(extracted.text),
            "normalized_char_count": len(content),
            "message_count": len(messages),
            "file_extension": path.suffix.lower(),
        },
        is_email_thread=is_thread,
        messages=messages,
    )
